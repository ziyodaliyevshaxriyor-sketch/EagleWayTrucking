<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EagleWay Trucking — Application</title>
  <style>
    :root{
      --blue:#0A2A57;
      --white:#ffffff;
      --black:#0C0C0C;
      --container:1200px;
      font-family: 'Inter', Poppins, system-ui, -apple-system, "Segoe UI", Roboto, 'Helvetica Neue', Arial;
    }
    body{margin:0;background:var(--white);color:var(--black);}
    .wrap{max-width:var(--container);margin:0 auto;padding:24px}

    /* HERO */
    .hero{display:flex;gap:24px;align-items:center;padding:36px 0}
    .hero .brand{flex:0 0 280px;text-align:center}
    .hero .brand img{max-width:100%;height:auto}
    .hero .title{flex:1}
    .hero h1{margin:0;font-size:36px;letter-spacing:1px;color:var(--blue)}
    .hero p.lead{margin:8px 0 0;font-size:16px;color:#333}
    .apply-btn{display:inline-block;margin-top:14px;padding:12px 20px;border-radius:10px;background:linear-gradient(180deg,var(--blue),#183b6f);color:var(--white);text-decoration:none}

    /* TWO COLUMNS */
    .cols{display:grid;grid-template-columns:1fr 520px;gap:28px;margin-top:18px}
    aside { max-width: 520px; width: 100%; }

    /* ABOUT (black bg) */
    .about{background:var(--black);color:var(--white);padding:22px;border-radius:8px}
    .about h2{color:var(--white);margin:0 0 8px}
    .about p{margin:8px 0;line-height:1.5}
    .locations{margin-top:12px}
    .locations li{margin:6px 0}

    /* FORM */
    .card{background:#f7f9fb;padding:20px;border-radius:10px}
    form .row{display:flex;gap:10px;margin-bottom:12px}
    form label{font-size:13px;color:#222;margin-bottom:6px;display:block}
    input[type="text"],input[type="email"],input[type="number"],input[type="tel"],select,textarea{width:100%;padding:10px;border-radius:6px;border:1px solid #d1d7de;font-size:14px}
    input[readonly],input[disabled],textarea[readonly]{background:#eceff4}
    .small{font-size:12px;color:#9aa3b2}
    .checkbox-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
    .muted{color:#666;font-size:13px}
    .paybox{background:#fff;padding:12px;border-radius:8px;border:1px solid #e2e6ea}

    /* contact */
    .contact{margin-top:18px;padding:14px;border-radius:8px;background:linear-gradient(180deg,#f6fbff,#eef6ff);border:1px solid #e0eefc}

    /* footer */
    footer{margin-top:26px;padding:18px 0;text-align:center;color:#666}

    /* responsive */
    @media (max-width:980px){
      .cols{grid-template-columns:1fr}
      .hero{flex-direction:column;align-items:flex-start}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <section class="hero">
      <div class="brand">
        <img src="images/logo.jpg" alt="EagleWay logo / ad" />
      </div>
      <div class="title">
        <h1>EAGLEWAY TRUCKING</h1>
        <p class="lead">OTR Company Drivers Application — Powered by performance. Driven by experience.</p>
        <a class="apply-btn" href="#application">Apply Now</a>
      </div>
    </section>

    <div class="cols">
      <!-- LEFT: ABOUT & LOCATIONS -->
      <div>
        <div class="about">
          <h2>ABOUT US</h2>
          <p><strong>EagleWay Trucking</strong> is a high-flow, professional OTR carrier operating since <strong>2017</strong>. We run with strict standards and reliable planning — today we have <strong>70+ professional OTR drivers</strong> delivering across the country, requiring <strong>4,000+ miles/week</strong>.</p>

          <p><strong>Forced Dispatch is in effect</strong>, ensuring consistent routing, stability, and on-time performance.</p>

          <p><strong>Based out of Columbus, Ohio</strong> with terminals and operations across 48 states.</p>

          <ul class="locations">
            <li>• Dayton, Ohio</li>
            <li>• Chicago, Illinois</li>
            <li>• Atlanta, Georgia</li>
            <li>• 48-state terminal coverage</li>
          </ul>

          <p class="muted">Empty miles — not paid.<br>“We are checking your MVR & background. After that we will call you back.”</p>
        </div>

        <div class="contact">
          <h3 style="margin:0 0 8px 0">CONTACT</h3>
          <p style="margin:0">📞 (515) 635-1204<br>✉️ ziyodaliyevshaxriyor@gmail.com<br>📨 Telegram: <a href="https://t.me/Shane_Toylar" target="_blank">t.me/Shane_Toylar</a></p>
        </div>
      </div>

      <!-- RIGHT: APPLICATION FORM -->
      <aside>
        <div id="application" class="card">
          <h2 style="margin-top:0">EAGLEWAY TRUCKING — Application Form</h2>
          <form id="appForm" onsubmit="return false;">
            <!-- FORM INPUTLARI shu yerda qoladi, o'zgarmadi -->
          </form>
        </div>
      </aside>
    </div>

    <footer>
      <small>Location notes: IL (Chicago), GA (Atlanta), OH (Dayton). MC/DOT not required. Not SAP friendly.</small>
    </footer>
  </div>

  <script>
    function updatePay(){
      const exp = Number(document.getElementById('experience')?.value || 0);
      const haz = document.getElementById('hazmat')?.checked;
      const cpmField = document.getElementById('cpmDisplay');
      const pctField = document.getElementById('pctDisplay');

      if(haz){
        cpmField.value = '70 CPM';
        pctField.value = '30% (hazmat only)';
        return;
      }

      if(exp >= 2){
        cpmField.value = '65 CPM';
        pctField.value = '28%';
      } else if(exp >= 1){
        cpmField.value = '60 CPM';
        pctField.value = '26%';
      } else {
        cpmField.value = '---';
        pctField.value = '---';
      }
    }

    updatePay();

    function submitForm(){
      const name = document.getElementById('fullName')?.value.trim();
      if(!name){alert('Please enter your full name.');return}
      alert('Application submitted (demo). We will check your MVR & background and call you back.');
    }
  </script>
</body>
</html>



